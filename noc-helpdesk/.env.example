# --- Server ---
PORT=4310
HOST=0.0.0.0
NODE_ENV=development

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=synoc
DB_PASSWORD=synoc_password
DB_NAME=synoc_noc
# Admin account used only by db/init.js to create/drop the schema
DB_ROOT_USER=synoc_admin
DB_ROOT_PASSWORD=synoc_admin_password

# --- Auth ---
# CHANGE THIS in production. Generate with: openssl rand -hex 48
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10

# --- App ---
APP_NAME=SYNOC
APP_ORG=NOC
TIMEZONE=Asia/Jakarta
